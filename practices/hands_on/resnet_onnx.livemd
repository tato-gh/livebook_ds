# Axon + Resnet Onnx

```elixir
Mix.install([
  {:nx, "~> 0.10"},
  {:exla, "~> 0.10"},
  {:axon_onnx, "~> 0.4", git: "https://github.com/mortont/axon_onnx/"},
  # {:axon_onnx, "~> 0.4"},
  # {:ortex, "~> 0.1"},
  {:stb_image, "~> 0.6.10"},
  {:download, "~> 0.0"},
  {:jason, "~> 1.4"},
  {:kino, "~> 0.18"}
], config: [nx: [default_backend: EXLA.Backend]])
```

## 記録

下記が引用元（うろ覚え）

https://qiita.com/piacerex/items/0f6115fd2691586b2598

* axon_onnx が最新のnx(0.10.0)に未対応の様子
* ということで`ortex`を使う
* と思ったら`cargo`を要求されたのでLivebook単体ではやめておく
* `axon_onnx`の0.4のGitHub上では更新済み（hex未配信）
* Resnetのモデル自体がhugging faceに移行していて簡単にはできなくなっている。

## 実装

```elixir
# モデルのロードまで（40～60秒程度かかります）

File.rm("imagenet_class_index.json")
File.rm("resnet18-v1-7.onnx")

# ResNetはImageNetで学習した1,000種類の教師ラベルで画像識別結果を出す
class_data_url = "https://s3.amazonaws.com/deep-learning-models/image-models/imagenet_class_index.json"
list =
  Download.from(class_data_url)
  |> elem(1)
  |> File.read!()
  |> Jason.decode!()

model_url = "https://huggingface.co/onnxmodelzoo/resnet18-v2-7/resolve/main/resnet18-v2-7.onnx"
{model, params} =
  Download.from(model_url)
  |> IO.inspect
  |> elem(1)
  |> AxonOnnx.import()
```

```elixir
# 再実行時、Download.from()でeexistエラーになるのを防止
File.rm("greatwhiteshark_157273892.jpg")

# 画像識別する対象をロード
data =
  Download.from("https://www.collinsdictionary.com/images/full/greatwhiteshark_157273892.jpg")
  |> elem(1)
  |> File.read!()

Kino.Image.new(data, :jpeg)
```

```elixir
# ResNetにインプットできるよう224 x 224 x 3の画像に加工
nx_image =
  data
  |> StbImage.read_binary!()
  |> StbImage.resize(224, 224)
  |> StbImage.to_nx()

nx_channels =
  nx_image
  |> Nx.axis_size(2)

nx_binary =
  case nx_channels do
    3 -> nx_image
    4 -> Nx.slice(nx_image, [0, 0, 0], [224, 224, 3])
  end
```

```elixir
# 224 x 224 x 3の画像に加工されていることを確認
nx_binary
|> StbImage.from_nx()
|> StbImage.write_file("changed.jpg")

File.read!("changed.jpg")
|> Kino.Image.new(:jpeg)
```

```elixir
# ResNetで扱える輝度に下げる
nx_binary
|> Nx.divide(255)
|> Nx.subtract(Nx.tensor([0.485, 0.456, 0.406]))
|> Nx.multiply(255)
|> Nx.as_type({:u, 8})
|> StbImage.from_nx()
|> StbImage.write_file("changed.jpg")

File.read!("changed.jpg")
|> Kino.Image.new(:jpeg)
```

```elixir
# ResNetで扱える配色に正規化
nx_binary
|> Nx.divide(255)
|> Nx.subtract(Nx.tensor([0.485, 0.456, 0.406]))
|> Nx.divide(Nx.tensor([0.229, 0.224, 0.225]))
|> Nx.multiply(255)
|> Nx.as_type({:u, 8})
|> StbImage.from_nx()
|> StbImage.write_file("changed.jpg")

File.read!("changed.jpg")
|> Kino.Image.new(:jpeg)
```

```elixir
# ResNetで扱えるよう横／縦／チャンネルを逆転させる
nx_binary
|> Nx.divide(255)
|> Nx.subtract(Nx.tensor([0.485, 0.456, 0.406]))
|> Nx.divide(Nx.tensor([0.229, 0.224, 0.225]))
|> Nx.transpose()
```

```elixir
# ResNetで扱えるよう深さを1段下げる
tensor =
  nx_binary
  |> Nx.divide(255)
  |> Nx.subtract(Nx.tensor([0.485, 0.456, 0.406]))
  |> Nx.divide(Nx.tensor([0.229, 0.224, 0.225]))
  |> Nx.transpose()
  |> Nx.new_axis(0)
```


```elixir
# 1,000種類の画像各々にどの程度、適合しているかを予測
predict_per_list = Axon.predict(model, params, tensor)
```

```elixir
# マッチ率をランク付け
rank =
  predict_per_list
  |> Nx.flatten()
  |> Nx.argsort()
  |> Nx.reverse()
```

```elixir
# 識別した1,000種類の教師ラベルを取得
rank
|> Nx.slice([0], [5])
|> Nx.to_flat_list()
|> Enum.with_index()
|> Enum.map(fn {no, index} -> {index, Map.get(list, to_string(no))} end)
```

